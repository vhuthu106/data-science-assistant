# Copy this file to .env and fill in your key.  .env is in .gitignore — never commit it.
OPENAI_API_KEY=

# Optional: choose a different model (default: gpt-4.1-mini)
# OPENAI_MODEL=gpt-4.1-mini

# Optional: any OpenAI-compatible provider, e.g. a local model served by Ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# Optional: seconds to wait for a reply (raise for slow local models, e.g. 300)
# LLM_TIMEOUT=60